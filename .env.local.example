# ---------------------------------------------------------------------------
# ClickVault environment  ->  copy to `.env.local` and fill in.
# Everything prefixed NEXT_PUBLIC_ is exposed to the browser (required for ad
# scripts). Never put anything secret in a NEXT_PUBLIC_ var.
# ---------------------------------------------------------------------------

# Canonical origin. Used for <link rel=canonical>, sitemap.xml, OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Monetisation: affiliate / smart link -----------------------------------
# The URL behind every "Claim Bonus" button on /games/[slug].
NEXT_PUBLIC_SMARTLINK_URL=https://example.com/smartlink-placeholder

# --- Monetisation: Google AdSense ------------------------------------------
# Publisher ID, e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=
# Manual ad unit slot IDs (numeric strings from the AdSense dashboard)
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
# Auto ads inject units automatically; set to "false" if you only want manual units.
NEXT_PUBLIC_ADSENSE_AUTO_ADS=true

# --- Monetisation: Adsterra ------------------------------------------------
# Popunder / OnClick key (the id in the //xyz.com/xx/yy/zz/invoke.js path)
NEXT_PUBLIC_ADSTERRA_POPUNDER_KEY=
# Social Bar key -- loaded ONLY on /games/[slug] pages
NEXT_PUBLIC_ADSTERRA_SOCIALBAR_KEY=

# Master switches. Popunders are the single most common cause of an AdSense
# policy strike -- keep this "false" while your AdSense application is pending
# and read the note in README.md before turning it on.
NEXT_PUBLIC_ENABLE_POPUNDER=false
NEXT_PUBLIC_ENABLE_SOCIALBAR=false

# --- Analytics (optional) --------------------------------------------------
NEXT_PUBLIC_GA_ID=
